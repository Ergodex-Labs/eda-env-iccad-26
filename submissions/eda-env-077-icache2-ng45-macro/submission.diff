diff --git a/config.mk b/config.mk
index 5f0a601..5b99aef 100644
--- a/config.mk
+++ b/config.mk
@@ -1,8 +1,6 @@
-# icache2 @ nangate45 — F5 macro-integration given: a WORKING
-# macro-less recipe. The stores are behavioral flop
-# arrays (src/icache2/spram_256x32.v), so the flow completes as
-# given, but the memory spec of the task (two fakeram45_256x32
-# SRAM macros) is not met.
+# icache2 @ nangate45 — F5 macro-integration: the two stores
+# (src/icache2/spram_256x32.v) wrap the platform SRAM macro
+# fakeram45_256x32, one instance per bank, two in total.
 export PLATFORM               = nangate45
 
 export DESIGN_NICKNAME        = icache2
@@ -11,12 +9,15 @@ export DESIGN_NAME            = icache2
 export VERILOG_FILES = $(sort $(wildcard $(WS)/src/icache2/*.v))
 export SDC_FILE      = $(WS)/constraint.sdc
 
-# Each behavioral bank is 8192 bits; the platform default cap (4096)
-# would refuse to synthesize it. The macro-less recipe is a WORKING
-# baseline by family contract, so the cap is raised here.
-export SYNTH_MEMORY_MAX_BITS    = 32768
+# Physical views of the SRAM macro (kit: /workspace/kit/README.md).
+# The liberty view makes synthesis treat fakeram45_256x32 as a black
+# box; the LEF gives placement its physical footprint.
+export ADDITIONAL_LEFS = $(PLATFORM_DIR)/lef/fakeram45_256x32.lef
+export ADDITIONAL_LIBS = $(PLATFORM_DIR)/lib/fakeram45_256x32.lib
+
+# Floorplan: two 78.66 x 64.40 um macros plus a small FSM. Size the
+# core explicitly so both macros fit side by side with their halos.
+export DIE_AREA  = 0 0 280 280
+export CORE_AREA = 10 10 270 270
 
-export CORE_UTILIZATION         = 45
-export CORE_ASPECT_RATIO        = 1
-export CORE_MARGIN              = 2
 export TNS_END_PERCENT          = 100
diff --git a/src/icache2/spram_256x32.v b/src/icache2/spram_256x32.v
index 4b59e2f..5390637 100644
--- a/src/icache2/spram_256x32.v
+++ b/src/icache2/spram_256x32.v
@@ -1,24 +1,31 @@
-// spram_256x32: single-port synchronous SRAM bank, behavioral.
+// spram_256x32: single-port synchronous SRAM bank.
 // Port contract (FROZEN — the module interface must not change):
 //   cs=1, we=1 -> write wdata to addr; rdata holds.
 //   cs=1, we=0 -> rdata <= mem[addr] (1-cycle read latency).
 //   cs=0      -> rdata holds; memory unchanged.
+//
+// Implementation: wraps the platform SRAM macro fakeram45_256x32.
+// The macro's control pins are ACTIVE-LOW (ce_in, we_in) and its writes
+// are masked by w_mask_in; the adaptation below is purely combinational
+// polarity/mask wiring, so the cycle-level contract above is preserved:
+//   cs=1, we=1 -> ce_in=0, we_in=0: masked write of wdata (mask all-ones).
+//   cs=1, we=0 -> ce_in=0, we_in=1: rd_out <= mem[addr] (1-cycle latency).
+//   cs=0       -> ce_in=1: rd_out holds; memory unchanged.
 module spram_256x32 (
     input             clk,
     input             cs,
     input             we,
     input      [7:0]  addr,
     input      [31:0] wdata,
-    output reg [31:0] rdata
+    output     [31:0] rdata
 );
-    reg [31:0] mem [0:255];
-
-    always @(posedge clk) begin
-        if (cs) begin
-            if (we)
-                mem[addr] <= wdata;
-            else
-                rdata <= mem[addr];
-        end
-    end
+    fakeram45_256x32 macro (
+        .clk       (clk),
+        .ce_in     (~cs),
+        .we_in     (~we),
+        .addr_in   (addr),
+        .wd_in     (wdata),
+        .w_mask_in (32'hFFFFFFFF),
+        .rd_out    (rdata)
+    );
 endmodule
