diff --git a/config.mk b/config.mk
index 11d337b..6042ff4 100644
--- a/config.mk
+++ b/config.mk
@@ -14,15 +14,29 @@ export ADDITIONAL_LIBS = $(PLATFORM_DIR)/lib/fakeram45_256x16.lib
 
 export IO_CONSTRAINTS = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/io.tcl
 
-export CORE_UTILIZATION = 60
+# Floorplan: give the 132 SRAM macros room to breathe.
+# Total std+macro area is ~712k um^2; with a real macro halo the
+# macro footprint grows a lot, so use a generously sized die.
+export DIE_AREA    = 0 0 1600 1600
+export CORE_AREA   = 15 15 1585 1585
 export CORE_ASPECT_RATIO = 1
 export CORE_MARGIN = 5
-export MACRO_PLACE_HALO    = 0.5 0.5
+
+# Wide halo around every macro to open up routing channels between them.
+export MACRO_PLACE_HALO    = 12 12
+export MACRO_BLOCKAGE_HALO = 8
+
 export SKIP_GATE_CLONING   = 1
-export RTLMP_MAX_LEVEL = 1
-export RTLMP_MAX_MACRO = 30
+
+# Let RTLMP handle all 132 macros instead of clustering them away.
+export RTLMP_MAX_LEVEL = 2
+export RTLMP_MAX_MACRO = 150
 export RTLMP_MIN_MACRO = 10
 export RTLMP_MAX_INST = 80000
 export RTLMP_MIN_INST = 8000
+
 export GPL_RANDOM_SEED = 3
 export TNS_END_PERCENT = 100
+
+# Keep placement density moderate so the router has space.
+export PLACE_DENSITY = 0.40
