diff --git a/config.mk b/config.mk
index 87f7090..0cf7be9 100644
--- a/config.mk
+++ b/config.mk
@@ -1,7 +1,11 @@
-# mult16 @ asap7 — F12 recipe-only given: the WORKING stock recipe.
-# The flow completes and closes its own 900 ps flow clock; the
-# trapped eval clock is tighter, and the stock synthesis recipe does
-# not reach it.
+# mult16 @ asap7 — recipe tuned to close the 653 ps eval clock.
+# Levers vs stock:
+#  - SLVT primary VT (fastest cells in the kit) with LVT+RVT available
+#    for the resizer's VT-swap passes.
+#  - ABC delay target set well below the eval clock so the mapped
+#    netlist has margin going into P&R.
+#  - Timing-driven global placement + full TNS repair.
+
 export PLATFORM               = asap7
 
 export DESIGN_NICKNAME        = mult16
@@ -14,3 +18,27 @@ export CORE_UTILIZATION       = 55
 export CORE_ASPECT_RATIO      = 1
 export CORE_MARGIN            = 2
 export TNS_END_PERCENT        = 100
+
+# Fastest threshold-voltage flavor as primary; keep the others around
+# so repair_timing can swap VT where it helps.
+export ASAP7_USE_VT           = SLVT LVT RVT
+
+# Make yosys/ABC optimize the multiply cone for a much tighter delay
+# target than the 900 ps flow clock (eval clock is 653 ps).
+export ABC_CLOCK_PERIOD_IN_PS = 300
+export ABC_SCRIPT_FILE         = $(WS)/abc.script
+
+# Restructure the multiply into a Booth-recoded architecture and
+# synthesize operators with abc9/gia.
+export SWAP_ARITH_OPERATORS    = 1
+export SYNTH_WRAPPED_MULTIPLIERS = BOOTH
+export SYNTH_WRAPPED_ADDERS    = KOGGE_STONE
+export OPENROAD_HIERARCHICAL   = 1
+
+# Timing-driven placement and aggressive setup repair.
+export GPL_TIMING_DRIVEN      = 1
+export GPL_ROUTABILITY_DRIVEN = 1
+# Make every setup-repair pass in P&R optimize as if the clock were
+# ~250 ps tighter than the 900 ps flow clock (i.e. the 653 ps eval
+# clock), instead of stopping at slack 0 for 900 ps.
+export SETUP_SLACK_MARGIN     = 650
