diff --git a/constraint.sdc b/constraint.sdc
index 310fc81..6582977 100644
--- a/constraint.sdc
+++ b/constraint.sdc
@@ -1,16 +1,32 @@
+# ethmac @ asap7 — product timing intent.
+#
+# Three clock domains, asynchronous to each other; the RTL synchronizes
+# every crossing, so inter-domain paths are false and must not be
+# optimized:
+#   wb_clk_i       1350 ps  Wishbone system clock (+ vclk for IO)
+#   mtx_clk_pad_i   405 ps  MII transmit clock   (+ vclk for IO)
+#   mrx_clk_pad_i   405 ps  MII receive clock    (+ vclk for IO)
+#
+# Each IO port is constrained against the virtual clock of ITS OWN
+# domain only, and the three domain groups are declared asynchronous.
+
+set clk_io_pct 0.2
+
+# ---------------------------------------------------------------------
+# Wishbone system domain (1350 ps)
+# ---------------------------------------------------------------------
 set top_clk_name wb_clk_i
 set clk_period 1350
-set clk_io_pct 0.2
 set clk_port [get_ports $top_clk_name]
 create_clock -name $top_clk_name -period $clk_period $clk_port
 set top_io_clk_name vclk_$top_clk_name
 create_clock -name $top_io_clk_name -period $clk_period
 set_clock_latency 229.195 [get_clocks $top_clk_name]
 set_clock_latency 229.195 [get_clocks $top_io_clk_name]
-set non_clock_inputs [all_inputs -no_clocks]
-set_input_delay [expr $clk_period * $clk_io_pct] -clock $top_io_clk_name $non_clock_inputs
-set_output_delay [expr $clk_period * $clk_io_pct] -clock $top_io_clk_name [all_outputs]
 
+# ---------------------------------------------------------------------
+# MII transmit domain (405 ps)
+# ---------------------------------------------------------------------
 set tx_clk_name mtx_clk_pad_i
 set tx_clk_port [get_ports $tx_clk_name]
 set tx_clk_period 405
@@ -19,10 +35,10 @@ set tx_io_clk_name vclk_$tx_clk_name
 create_clock -name $tx_io_clk_name -period $tx_clk_period
 set_clock_latency 55.660 [get_clocks $tx_clk_name]
 set_clock_latency 55.660 [get_clocks $tx_io_clk_name]
-set mtx_non_clock_inputs [lsearch -inline -all -not -exact [all_inputs] $tx_clk_port]
-set_input_delay [expr $tx_clk_period * $clk_io_pct] -clock $tx_io_clk_name $mtx_non_clock_inputs
-set_output_delay [expr $tx_clk_period * $clk_io_pct] -clock $tx_io_clk_name [all_outputs]
 
+# ---------------------------------------------------------------------
+# MII receive domain (405 ps)
+# ---------------------------------------------------------------------
 set rx_clk_name mrx_clk_pad_i
 set rx_clk_port [get_ports $rx_clk_name]
 set rx_clk_period 405
@@ -31,10 +47,47 @@ set rx_io_clk_name vclk_$rx_clk_name
 create_clock -name $rx_io_clk_name -period $rx_clk_period
 set_clock_latency 76.515 [get_clocks $rx_clk_name]
 set_clock_latency 76.515 [get_clocks $rx_io_clk_name]
-set mrx_non_clock_inputs [lsearch -inline -all -not -exact [all_inputs] $rx_clk_port]
-set_input_delay [expr $rx_clk_period * $clk_io_pct] -clock $rx_io_clk_name $mrx_non_clock_inputs
-set_output_delay [expr $rx_clk_period * $clk_io_pct] -clock $rx_io_clk_name [all_outputs]
 
+# ---------------------------------------------------------------------
+# Per-domain IO delays: every port is budgeted against the virtual
+# clock of the domain that actually launches/captures it.
+# ---------------------------------------------------------------------
+# Transmit domain ports: MII Tx outputs to the PHY, plus the collision /
+# carrier-sense inputs whose synchronizers live in the Tx domain.
+set tx_inputs  [get_ports {mcoll_pad_i mcrs_pad_i}]
+set tx_outputs [get_ports {mtxd_pad_o[*] mtxen_pad_o mtxerr_pad_o}]
+
+# Receive domain ports: MII Rx inputs from the PHY.
+set rx_inputs  [get_ports {mrxd_pad_i[*] mrxdv_pad_i mrxerr_pad_i}]
+set rx_outputs {}
+
+# Everything else (Wishbone slave/master, interrupt, MII management —
+# eth_miim is clocked by wb_clk_i — and any remaining port) belongs to
+# the Wishbone system domain.
+set all_in  [all_inputs]
+set all_out [all_outputs]
+set wb_inputs  [lsearch -inline -all -not -exact \
+  [lsearch -inline -all -not -exact $all_in  $tx_clk_port] $rx_clk_port]
+set wb_inputs  [lsearch -inline -all -not -exact $wb_inputs $top_clk_name]
+foreach p $tx_inputs { set wb_inputs [lsearch -inline -all -not -exact $wb_inputs $p] }
+foreach p $rx_inputs { set wb_inputs [lsearch -inline -all -not -exact $wb_inputs $p] }
+set wb_outputs $all_out
+foreach p $tx_outputs { set wb_outputs [lsearch -inline -all -not -exact $wb_outputs $p] }
+
+set_input_delay  [expr $clk_period    * $clk_io_pct] -clock $top_io_clk_name $wb_inputs
+set_output_delay [expr $clk_period    * $clk_io_pct] -clock $top_io_clk_name $wb_outputs
+set_input_delay  [expr $tx_clk_period * $clk_io_pct] -clock $tx_io_clk_name  $tx_inputs
+set_output_delay [expr $tx_clk_period * $clk_io_pct] -clock $tx_io_clk_name  $tx_outputs
+set_input_delay  [expr $rx_clk_period * $clk_io_pct] -clock $rx_io_clk_name  $rx_inputs
+
+# ---------------------------------------------------------------------
+# The three domains are asynchronous; every crossing is synchronized in
+# the RTL. Cut all inter-domain paths so the optimizer only works on
+# real paths.
+# ---------------------------------------------------------------------
+set_clock_groups -name async_domains -asynchronous \
+  -group [concat [get_clocks $top_clk_name] [get_clocks $top_io_clk_name]] \
+  -group [concat [get_clocks $tx_clk_name]  [get_clocks $tx_io_clk_name]] \
+  -group [concat [get_clocks $rx_clk_name]  [get_clocks $rx_io_clk_name]]
 
 set_max_fanout 10 [current_design]
-# NOTE: constraints regenerated from the domain spreadsheet import.
