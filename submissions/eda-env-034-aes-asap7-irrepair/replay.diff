diff --git a/config.mk b/config.mk
index 5b49fec..4dc17fe 100644
--- a/config.mk
+++ b/config.mk
@@ -13,6 +13,16 @@ export CORE_MARGIN              = 2
 export PLACE_DENSITY            = 0.55
 export TNS_END_PERCENT          = 100
 
+# Timing closure: enable setup/hold repair during the placement resize
+# stage (disabled by default). Gives repair_timing freedom to size/buffer/
+# VT-swap before CTS, helping close the small residual setup violation.
+export ENABLE_PLACE_REPAIR_TIMING = 1
+
+# Use low-Vt (faster) standard cells to close setup timing at the tight clock.
+# Leakage is a negligible fraction of total power for this design, so total
+# power stays well within budget while the critical path gets faster.
+export ASAP7_USE_VT = LVT
+
 ifeq ($(FLOW_VARIANT),top)
 	export DESIGN_NAME = aes_cipher_top
 	export SYNTH_BLACKBOXES = aes_key_expand_128
