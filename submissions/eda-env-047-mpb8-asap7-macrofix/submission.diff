diff --git a/hooks/macro_placement.tcl b/hooks/macro_placement.tcl
new file mode 100644
index 0000000..d014c8b
--- /dev/null
+++ b/hooks/macro_placement.tcl
@@ -0,0 +1,73 @@
+# Manual macro placement for mpb_soc8 (18 x fakeram7_256x32, 8.36 x 42.0 um).
+#
+# The default rtl_macro_placer crowds the 18 RAM banks together at high
+# utilization, starving the routing channels and causing sign-off DRCs.
+# Here we spread the macros in a regular 2 x 9 grid derived from the actual
+# core area: equal vertical channels between columns (pin access: all macro
+# pins live on the left/right edges) and one wide horizontal channel in the
+# middle that holds the (tiny) standard-cell logic.
+
+set block [ord::get_db_block]
+set core [$block getCoreArea]
+
+set core_x0 [ord::dbu_to_microns [$core xMin]]
+set core_y0 [ord::dbu_to_microns [$core yMin]]
+set core_x1 [ord::dbu_to_microns [$core xMax]]
+set core_y1 [ord::dbu_to_microns [$core yMax]]
+
+set core_w [expr {$core_x1 - $core_x0}]
+set core_h [expr {$core_y1 - $core_y0}]
+
+set macro_w 8.360
+set macro_h 42.000
+
+set ncols 9
+set nrows 2
+
+# Equal horizontal gaps: left/right margins + inter-column channels.
+set gap_x [expr {($core_w - $ncols * $macro_w) / ($ncols + 1)}]
+# Vertical: top/bottom margins + one middle channel.
+set gap_y [expr {($core_h - $nrows * $macro_h) / ($nrows + 1)}]
+
+# The fakeram signal pins are 0.024 um M4 slivers whose centers sit exactly
+# on the M4/M5 routing-track grid (pitch 0.048, offset 0.012) when the macro
+# origin is an integer multiple of 0.048 um.  Off-track placement makes the
+# pins unreachable (DRT-0255), so snap every origin to that grid.
+set track_pitch 0.048
+proc snap_track {v} {
+  variable track_pitch
+  return [expr {$track_pitch * floor($v / $track_pitch + 0.5)}]
+}
+
+puts "macro_placement: core ${core_w}x${core_h} gap_x=$gap_x gap_y=$gap_y"
+
+# Collect the bank macros (instance names contain escaped brackets, so match
+# on the index with a regexp instead of hard-coding names).
+set macros {}
+foreach inst [$block getInsts] {
+  set master [$inst getMaster]
+  if {[$master getType] == "BLOCK"} {
+    set name [$inst getName]
+    if {[regexp {g_bank\\\[(\d+)\\\]\.u_mem} $name -> idx]} {
+      lappend macros [list $idx $name]
+    } else {
+      error "Unexpected macro instance $name"
+    }
+  }
+}
+set macros [lsort -integer -index 0 $macros]
+if {[llength $macros] != $ncols * $nrows} {
+  error "Expected [expr {$ncols * $nrows}] macros, found [llength $macros]"
+}
+
+set i 0
+foreach entry $macros {
+  set name [lindex $entry 1]
+  set row [expr {$i / $ncols}]
+  set col [expr {$i % $ncols}]
+  set x [snap_track [expr {$core_x0 + $gap_x + $col * ($macro_w + $gap_x)}]]
+  # Row 0 at the bottom, row 1 at the top.
+  set y [snap_track [expr {$core_y0 + $gap_y + $row * ($macro_h + $gap_y)}]]
+  place_macro -macro_name $name -location [list $x $y] -orientation R0 -exact
+  incr i
+}
