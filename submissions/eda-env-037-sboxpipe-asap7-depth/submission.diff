diff --git a/config.mk b/config.mk
index 068f769..7220b79 100644
--- a/config.mk
+++ b/config.mk
@@ -11,3 +11,16 @@ export CORE_ASPECT_RATIO        = 1
 export CORE_MARGIN              = 2
 export PLACE_DENSITY            = 0.55
 export TNS_END_PERCENT          = 100
+
+# Timing-driven effort
+export GPL_TIMING_DRIVEN        = 1
+export GPL_ROUTABILITY_DRIVEN   = 1
+
+# Use the super-low-Vt ASAP7 flavor: substantially faster cells than RVT.
+export ASAP7_USE_VT             = SLVT
+
+# Overfix setup timing: repair_timing optimizes the critical path as if the
+# clock were this many ps tighter than the 400 ps SDC, WITHOUT modifying the
+# saved SDC.  This builds large margin against the 312 ps evaluation clock
+# while keeping the constraint file intact (WNS stays >= 0 at 400 ps).
+export SETUP_SLACK_MARGIN       = 270
