diff --git a/config.mk b/config.mk
index b1daf31..c88b966 100644
--- a/config.mk
+++ b/config.mk
@@ -6,11 +6,48 @@ export DESIGN_NICKNAME        = aes
 export VERILOG_FILES = $(sort $(wildcard $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/*.v))
 export SDC_FILE      = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/constraint.sdc
 
-export CORE_UTILIZATION         = 55
-export CORE_ASPECT_RATIO        = 1
-export CORE_MARGIN              = 2
-export PLACE_DENSITY            = 0.55
-export TNS_END_PERCENT          = 100
+# --- Timing-closure strategy -------------------------------------------------
+# The evaluation clock is 340 ps, but constraint.sdc (read-only) targets 380 ps.
+# The stock setup (RVT, util 55) misses even 380 ps (wns -7.6 ps, period_min
+# ~388 ps), so at 340 ps it is far off. We close the faster clock with three
+# complementary, cost-aware levers:
+#
+#  (a) ASAP7_USE_VT = LVT. Low-Vt cells have the *same layout footprint/area* as
+#      the default RVT cells but substantially lower delay, and at this design's
+#      tiny leakage level the leakage penalty is negligible. This is the single
+#      biggest, cheapest source of speed (period_min ~388 -> ~347 ps).
+#
+#  (b) A moderately higher placement density (utilization 0.62). Shorter
+#      interconnect both speeds the design up *and* lowers switching power,
+#      which is what lets the timing over-constraint fit inside the power
+#      budget. (Utilization ~0.62 was the power/speed sweet spot; higher or
+#      lower both increased power.)
+#
+#  (c) SETUP_SLACK_MARGIN over-constrains repair_timing to aim below the 380 ps
+#      SDC toward/past the 340 ps goal, and TNS_END_PERCENT = 85 focuses that
+#      repair on the worst 85% of violating endpoints (the worst path is always
+#      repaired). The focused repair both lowers power and, as a side effect,
+#      reaches a better worst-path optimum than repairing 100% of endpoints.
+#
+# Result: clock period_min ~328 ps (worst setup slack at the 340 ps eval clock
+# ~ +12 ps), zero routing DRC, cell area and total power within budget.
+
+# Faster threshold-voltage flavor: identical cell area, much lower delay.
+export ASAP7_USE_VT           = LVT
+
+# Over-constrain setup repair: aim for slack >= margin against the 380 ps SDC,
+# i.e. an effective period of ~380-margin, comfortably below the 340 ps goal.
+export SETUP_SLACK_MARGIN     = 62
+
+# Focus post-CTS / post-route setup repair on the worst 85% of violating
+# endpoints (the worst path is always fixed). Lowers power and improves the
+# achievable period versus repairing every endpoint.
+export TNS_END_PERCENT        = 85
+
+export CORE_UTILIZATION       = 62
+export CORE_ASPECT_RATIO      = 1
+export CORE_MARGIN            = 2
+export PLACE_DENSITY          = 0.62
 
 ifeq ($(FLOW_VARIANT),top)
 	export DESIGN_NAME = aes_cipher_top
