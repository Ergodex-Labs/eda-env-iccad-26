diff --git a/config.mk b/config.mk
index b1daf31..7a8f448 100644
--- a/config.mk
+++ b/config.mk
@@ -6,6 +6,21 @@ export DESIGN_NICKNAME        = aes
 export VERILOG_FILES = $(sort $(wildcard $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/*.v))
 export SDC_FILE      = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/constraint.sdc
 
+# --- Speed: give the tools access to fast low-Vt cells (RVT primary + LVT +
+# --- SLVT). Leakage is a negligible fraction of total power for this design,
+# --- so the faster VT flavors buy setup slack almost for free.
+export ASAP7_USE_VT           = RVT LVT SLVT
+
+# --- Target the real evaluation clock (329.5 ps) throughout PnR via a hook
+# --- that re-creates the clocks after the SDC is loaded at floorplan; the
+# --- rewritten constraints then propagate to every later stage.
+export TARGET_CLK_PERIOD      = 329.5
+export PRE_FLOORPLAN_TCL      = $(WS)/hooks/tighten_clock.tcl
+
+# --- Over-constrain setup repair to build positive slack margin at the
+# --- evaluation clock (repair targets clock - margin).
+export SETUP_SLACK_MARGIN     = 37
+
 export CORE_UTILIZATION         = 55
 export CORE_ASPECT_RATIO        = 1
 export CORE_MARGIN              = 2
diff --git a/hooks/tighten_clock.tcl b/hooks/tighten_clock.tcl
new file mode 100644
index 0000000..0fa59c9
--- /dev/null
+++ b/hooks/tighten_clock.tcl
@@ -0,0 +1,39 @@
+# Hook: re-target the design clock to a tighter period than the (read-only)
+# constraint.sdc provides, so the whole PnR flow optimizes for the real
+# evaluation clock. The period (ps) is taken from TARGET_CLK_PERIOD env var,
+# defaulting to the 329.5 ps evaluation clock.
+#
+# Mirrors the structure of constraint.sdc: an internal clock on the clk port
+# plus a virtual I/O clock, both with the same latency, and I/O delays at a
+# fixed fraction of the period. If the incoming SDC already uses the target
+# period this is a harmless no-op rewrite.
+
+set target_period 329.5
+if { [info exists ::env(TARGET_CLK_PERIOD)] && $::env(TARGET_CLK_PERIOD) ne "" } {
+  set target_period $::env(TARGET_CLK_PERIOD)
+}
+set clk_io_pct 0.2
+set clk_latency 77.930
+
+set clk_port [get_ports clk]
+set non_clock_inputs [all_inputs -no_clocks]
+set out_ports [all_outputs]
+
+# Delete the clocks coming from the propagated SDC (this also drops the I/O
+# delays referenced to the virtual clock), then re-create them cleanly at the
+# tighter target period. Guarded so a missing clock never aborts the stage.
+foreach c {clk vclk_clk} {
+  if { [llength [get_clocks -quiet $c]] > 0 } {
+    delete_clock [get_clocks $c]
+  }
+}
+
+create_clock -name clk -period $target_period $clk_port
+create_clock -name vclk_clk -period $target_period
+set_clock_latency $clk_latency [get_clocks clk]
+set_clock_latency $clk_latency [get_clocks vclk_clk]
+
+set_input_delay [expr $target_period * $clk_io_pct] -clock vclk_clk $non_clock_inputs
+set_output_delay [expr $target_period * $clk_io_pct] -clock vclk_clk $out_ports
+
+puts "tighten_clock: re-targeted clk/vclk_clk to $target_period ps"
