diff --git a/config.mk b/config.mk
index b1daf31..22faa55 100644
--- a/config.mk
+++ b/config.mk
@@ -12,6 +12,17 @@ export CORE_MARGIN              = 2
 export PLACE_DENSITY            = 0.55
 export TNS_END_PERCENT          = 100
 
+# Use the fastest (super-low-Vt) ASAP7 cell library for both synthesis and
+# physical implementation. SLVT-only gave a cleaner/faster netlist and let
+# timing repair push further than a mixed SLVT/LVT/RVT library set.
+export ASAP7_USE_VT             = SLVT
+
+# Over-constrain setup repair: repair_timing targets this much positive
+# slack (ps) against the 380 ps flow clock, i.e. it optimizes paths toward
+# ~210 ps. This buys large positive slack at the 385.5 ps evaluation clock
+# and minimizes the effective clock period (min period achieved ~291 ps).
+export SETUP_SLACK_MARGIN       = 170
+
 ifeq ($(FLOW_VARIANT),top)
 	export DESIGN_NAME = aes_cipher_top
 	export SYNTH_BLACKBOXES = aes_key_expand_128
@@ -26,3 +37,4 @@ else ifeq ($(FLOW_VARIANT),combine)
 endif
 
 export SYNTH_USE_SYN = 1
+
