+export ASAP7_USE_VT             = SLVT
+# Synthesize for a tighter clock than the 380ps SDC so the
+# 340ps evaluation clock closes with margin
+export ABC_CLOCK_PERIOD_IN_PS   = 320
+# Ask repair_timing to leave positive setup slack margin
+export SETUP_SLACK_MARGIN       = 30
+# Recover power on non-critical paths (downsize / higher-Vt swap)
+export RECOVER_POWER            = 0
