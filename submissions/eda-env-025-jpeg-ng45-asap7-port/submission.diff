diff --git a/config.mk b/config.mk
index 3912a78..ec0d7c0 100644
--- a/config.mk
+++ b/config.mk
@@ -1,7 +1,7 @@
-# jpeg @ asap7 — RTL-based (the image's asap7/jpeg dir is the NETLIST-input
-# AutoTuner variant, which kills the synthesis levers). Freeze-replica
-# inputs (DataIn/jpeg_encoder/ASAP7): fixed floorplan DEF + freeze SDC
-# (400 ps, ICCAD-2025 nominal). RTL from designs/src/jpeg.
+# jpeg @ asap7 — RTL-based port from Nangate45.
+# Design identity is pinned below; the rest of this file completes the
+# ASAP7 flow configuration. RTL comes from designs/src/jpeg, constraints
+# from $(WS)/constraint.sdc (1100 ps clock).
 export PLATFORM               = asap7
 
 export DESIGN_NAME            = jpeg_encoder
@@ -10,3 +10,23 @@ export DESIGN_NICKNAME        = jpeg
 export VERILOG_FILES = $(sort $(wildcard $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/*.v))
 export VERILOG_INCLUDE_DIRS = $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/include
 export SDC_FILE      = $(WS)/constraint.sdc
+
+# --- Synthesis -------------------------------------------------------------
+# Area-oriented ABC strategy (matches the Nangate45 source setup and the
+# asap7 jpeg_lvt reference); keeps the netlist small which helps congestion.
+export ABC_AREA               = 1
+
+# --- Floorplan -------------------------------------------------------------
+# ASAP7 is a fine, dense node; jpeg_lvt (same design) closes at util=30.
+# A moderate utilization keeps routing DRC under control at the relaxed
+# 1100 ps clock.
+export CORE_UTILIZATION       = 40
+export CORE_ASPECT_RATIO      = 1
+export CORE_MARGIN            = 2
+
+# --- Placement -------------------------------------------------------------
+export PLACE_DENSITY          = 0.60
+
+# --- Timing repair ---------------------------------------------------------
+# Fix all violating endpoints post-CTS (clock is relaxed, so this is cheap).
+export TNS_END_PERCENT        = 100
